# infra/.env — optional overrides for docker-compose.yml (local development only).
# Docker Compose reads infra/.env automatically (it sits in the compose project directory).
# The defaults below match apps/api/.env.example.

# Postgres superuser for the local container
POSTGRES_USER=boramarca
POSTGRES_PASSWORD=boramarca
# Evolution API global key (must match EVOLUTION_API_KEY in apps/api/.env)
EVOLUTION_API_KEY=change-me-evolution-key
