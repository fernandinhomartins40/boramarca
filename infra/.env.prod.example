# infra/.env.prod — production settings for docker-compose.prod.yml. Copy to infra/.env.prod on the
# server (never commit it), fill every "change-me", then:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d --build
# The same file is read by Compose (interpolation) and by the API process (env_file), so the API
# variables from apps/api/.env.example go here too. Generate secrets with:
#   openssl rand -base64 48        (or: node -e "console.log(crypto.randomBytes(48).toString('base64url'))")
# The API refuses to start in production while any secret is still "change-me", the two JWT
# secrets are equal, or WHATSAPP_WEBHOOK_SECRET is shorter than 16 characters.
# Logs: keep container logs for at most 30 days (privacy policy), e.g. Docker's journald driver
# with journald MaxRetentionSec=30day, or the json-file driver plus a 30-day logrotate.

# ---- Domains (DNS A/AAAA records must point to the VPS before the first start: Caddy gets the
# certificates from Let's Encrypt on its own) and the e-mail Let's Encrypt writes to.
SITE_DOMAIN=boramarca.com.br
API_DOMAIN=api.boramarca.com.br
ACME_EMAIL=change-me@boramarca.com.br
# Image tag built by `up --build` (any label; change it to keep the previous images around)
RELEASE=latest

# ---- Site build (NEXT_PUBLIC_*; a change needs `up -d --build web`)
SUPPORT_EMAIL=contato@boramarca.com.br
# Store links: the landing shows the buttons only when set
PLAY_URL=
APPSTORE_URL=

# ---- Infrastructure (internal network only; nothing below is exposed to the internet)
POSTGRES_USER=boramarca
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password
# Evolution global API key; the API uses the same value
EVOLUTION_API_KEY=change-me-evolution-key

# ---- API (full list and comments: apps/api/.env.example). DATABASE_URL, REDIS_URL,
# EVOLUTION_BASE_URL, PUBLIC_API_URL, CORS_ORIGINS, NODE_ENV and TRUST_PROXY=true are set by the
# compose file from the values above.
LOG_LEVEL=info
# Two different secrets, 32+ characters each
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Secret Evolution sends back on webhooks (16+ characters)
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret
# Encrypts secrets saved per professional (Voice Monkey token). 32 bytes in base64:
#   openssl rand -base64 32      — never change it after tokens are saved (they become unreadable)
DATA_ENCRYPTION_KEY=
# Store review account: a number that belongs to no real professional + a fixed 6-digit code
REVIEW_PHONE=
REVIEW_OTP=
# SMS of the login code by Firebase Authentication (docs/PENDENCIAS-HUMANAS.md, item 3). Set it to
# rapidinho-entrega (shared Firebase project of the owner's products) only after the Phone provider is on in the Firebase console; empty = no SMS.
FIREBASE_PROJECT_ID=
# AI and transcription (packages/ia/.env.example). Empty: AI off, messages only reach the app.
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-flash
LLM_FALLBACK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen3.8-flash
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Push: Expo in production; access token only with "enhanced push security"
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
# Alexa (packages/alexa/.env.example, docs/PENDENCIAS-HUMANAS.md, item 16). Empty: skill and linking answer 503.
ALEXA_SKILL_ID=
ALEXA_OAUTH_CLIENT_ID=alexa-skill
ALEXA_OAUTH_CLIENT_SECRET=
# Optional fallback Voice Monkey v3 token (each professional normally saves their own in the app)
VOICE_MONKEY_TOKEN=
# Transactional e-mail (Velomail, docs/OPERACAO.md "E-mail transacional"). Empty key: mails are
# only logged (no body in production). MAIL_OPS_TO gets a notice per site lead (empty: none).
VELOMAIL_API_KEY=
MAIL_FROM=Bora Marca <nao-responda@boramarca.com.br>
MAIL_REPLY_TO=contato@boramarca.com.br
MAIL_OPS_TO=
PUBLIC_SITE_URL=https://boramarca.com.br
PUBLIC_API_BASE_URL=https://api.boramarca.com.br
# Subscription billing (Asaas, docs/COBRANCA.md). Empty key: billing off (503), the rest works.
# The key starts with "$aact_": keep it between SINGLE quotes or Compose eats the "$".
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
# openssl rand -hex 32; the same token goes on the Asaas webhook https://api.boramarca.com.br/v1/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=
BILLING_GRACE_DAYS=7
