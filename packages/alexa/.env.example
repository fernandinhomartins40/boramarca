# packages/alexa — read by the API (readAlexaConfig). Never commit real values.

# Skill id from the Alexa developer console (amzn1.ask.skill....). Requests for any other skill are rejected.
ALEXA_SKILL_ID=

# Account linking (Build > Account Linking in the console). Same values in both places.
# Client ID: any stable string, e.g. "alexa-skill".
ALEXA_OAUTH_CLIENT_ID=
# Client secret: long random string (openssl rand -hex 32), at least 16 characters.
ALEXA_OAUTH_CLIENT_SECRET=

# Voice Monkey v3 API token (voicemonkey.io > Dashboard > API). Optional: empty turns the
# proactive announcement off for everyone. v2 tokens do not work.
VOICE_MONKEY_TOKEN=
