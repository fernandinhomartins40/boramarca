# @boramarca/whatsapp — variables read by the API (apps/api) through this package.
# Development values only. Never commit a real .env.

# ---- Evolution API (infra/docker-compose.yml, official image evoapicloud/evolution-api:v2.3.7)
EVOLUTION_BASE_URL=http://localhost:8085
# Global key; must match AUTHENTICATION_API_KEY of the Evolution container (infra/.env EVOLUTION_API_KEY)
EVOLUTION_API_KEY=change-me-evolution-key
# Sent back by Evolution in the x-boramarca-webhook-secret header; min. 16 characters
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret
# Base URL Evolution uses to reach the API (from inside Docker: host.docker.internal)
PUBLIC_API_URL=http://host.docker.internal:3333

# ---- Send guard (plan section 7). Leave empty to use SEND_GUARD_DEFAULTS.
# Messages per instance per minute / per day
WA_GUARD_PER_MINUTE=8
WA_GUARD_PER_DAY=200
# "digitando..." before each message, in seconds
WA_GUARD_TYPING_MIN_SECONDS=2
WA_GUARD_TYPING_MAX_SECONDS=8
# Characters per message and max messages per text (longer texts are blocked)
WA_GUARD_MAX_CHARS=500
WA_GUARD_MAX_PARTS=2
# Queued messages older than this are dropped (e.g. after the session came back)
WA_GUARD_DROP_QUEUED_AFTER_MINUTES=30
