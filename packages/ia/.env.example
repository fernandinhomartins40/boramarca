# packages/ia — LLM and transcription. Never commit real keys.
# Identifiers and URLs checked in the providers' official docs on 2026-11-12 (sources in README.md).
# Any OpenAI-compatible endpoint works: change only these variables to switch provider.

# --- Primary model (OpenAI-compatible chat completions with tool calling) ---
# DeepSeek (hosted in China). Models listed in the docs: deepseek-flash (cheap, fast), deepseek-v4-pro.
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-flash

# --- Fallback model, used when the primary fails or times out ---
# Qwen on Alibaba Cloud Model Studio, international deployment (Singapore). Recommended: the
# workspace domain https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# (replace {WorkspaceId}); the legacy shared domain below still works. The key must be from the same region.
# US (Virginia): https://{WorkspaceId}.us-east-1.maas.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
# qwen3.8-flash (fast, cheap) or qwen3.7-plus (balanced)
LLM_FALLBACK_MODEL=qwen3.8-flash

# Per-attempt timeout in ms (default 15000). Each endpoint gets 1 retry before switching.
LLM_TIMEOUT_MS=15000

# --- Audio transcription (OpenAI-compatible /audio/transcriptions) ---
# Groq Whisper: whisper-large-v3-turbo (fast, cheap) or whisper-large-v3
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# ISO-639-1 language hint (default pt)
TRANSCRIBE_LANGUAGE=pt
