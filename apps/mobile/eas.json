{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3333",
        "EXPO_PUBLIC_SITE_URL": "https://boramarca.com.br"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "api",
        "EXPO_PUBLIC_API_URL": "https://api-homolog.boramarca.com.br",
        "EXPO_PUBLIC_SITE_URL": "https://boramarca.com.br"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "api",
        "EXPO_PUBLIC_API_URL": "https://api.boramarca.com.br",
        "EXPO_PUBLIC_SITE_URL": "https://boramarca.com.br"
      }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    }
  }
}
