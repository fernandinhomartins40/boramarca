# apps/mobile — copy to apps/mobile/.env. EXPO_PUBLIC_* values are embedded in the JS bundle:
# never put secrets here other than the Picovoice AccessKey (which is meant for the device).
# After changing a value, restart Metro with --clear.

# mock = demo data from the references; api = real backend (plan section 11)
EXPO_PUBLIC_DATA_SOURCE=mock
# apps/api base URL. Android emulator reaches the host at 10.0.2.2
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333
# Picovoice AccessKey (console.picovoice.ai) for the "Ei, Bora Marca" wake word (Porcupine). It also
# needs the .ppn/.pv files in assets/wakeword (docs/PENDENCIAS-HUMANAS.md, item 10). Empty = simulated wake word
# and the on-screen "Falar" button.
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=
# true = dev menu and vitrine (app/dev) also in release/QA builds. Never set it in production.
EXPO_PUBLIC_DEV_TOOLS=
# Public site (apps/web) opened by Ajustes → Conta: /privacidade, /termos, /excluir-conta, /contato.
# Empty = https://boramarca.com.br. Local site on the emulator: http://10.0.2.2:3000
EXPO_PUBLIC_SITE_URL=
