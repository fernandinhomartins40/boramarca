{
  "name": "@boramarca/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@boramarca/alexa": "workspace:*",
    "@boramarca/ia": "workspace:*",
    "@boramarca/shared": "workspace:*",
    "@boramarca/whatsapp": "workspace:*",
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.4.2",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/websocket": "^11.3.7",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "drizzle-kit": "^0.31.11",
    "node-forge": "1.4.3",
    "pino-pretty": "^13.2.0"
  }
}
