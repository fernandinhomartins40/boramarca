# apps/api — copy to apps/api/.env for local development. Never commit .env.

# development | test | production
NODE_ENV=development
# HTTP server
HOST=0.0.0.0
PORT=3333
# fatal | error | warn | info | debug | trace (no message content or phones at info)
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (web site/panel, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Postgres from infra/docker-compose.yml (host port 5440)
DATABASE_URL=postgres://boramarca:boramarca@localhost:5440/boramarca
# Separate database for integration tests (created by infra/postgres/init.sql)
DATABASE_URL_TEST=postgres://boramarca:boramarca@localhost:5440/boramarca_test
# Redis from infra/docker-compose.yml (host port 6390). db 0 = app/BullMQ, db 1 = tests; Evolution uses db 6
REDIS_URL=redis://localhost:6390/0
REDIS_URL_TEST=redis://localhost:6390/1

# JWT secrets (at least 32 chars; generate with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Evolution API (infra/docker-compose.yml, host port 8085). Must match AUTHENTICATION_API_KEY in infra/.env
EVOLUTION_BASE_URL=http://localhost:8085
EVOLUTION_API_KEY=change-me-evolution-key
# Secret Evolution sends back on webhooks (header x-boramarca-webhook-secret)
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret
# Public URL Evolution uses to reach this API (from inside Docker: host.docker.internal)
PUBLIC_API_URL=http://host.docker.internal:3333

# Store review demo account (plan section 9). Leave empty to disable.
REVIEW_PHONE=
REVIEW_OTP=

# ---- Send guard (plan section 7; read by packages/whatsapp). Optional: empty = SEND_GUARD_DEFAULTS.
# Messages per instance per minute / per day
WA_GUARD_PER_MINUTE=
WA_GUARD_PER_DAY=
# "digitando..." before each message, in seconds
WA_GUARD_TYPING_MIN_SECONDS=
WA_GUARD_TYPING_MAX_SECONDS=
# Characters per message and max messages per text (longer texts are blocked)
WA_GUARD_MAX_CHARS=
WA_GUARD_MAX_PARTS=
# Queued messages older than this are dropped (e.g. after the session came back)
WA_GUARD_DROP_QUEUED_AFTER_MINUTES=

# ---- AI (read by packages/ia; see packages/ia/.env.example and README for providers).
# Without LLM_PRIMARY_*: outside production a simulated AI turns every message into a Decision;
# in production the AI is off and messages only reach the app.
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-flash
# Fallback used when the primary fails or times out (Qwen, Model Studio Singapore)
LLM_FALLBACK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen3.8-flash
# Per-attempt timeout in ms (default 15000)
LLM_TIMEOUT_MS=15000
# Audio transcription (OpenAI-compatible /audio/transcriptions, e.g. Groq Whisper).
# Without a key: fake transcription outside production; in production audios only reach the app.
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LANGUAGE=pt

# ---- Decisions and push notifications
# Minutes before the neutral "Já te confirmo!" goes to the client (default 10)
DECISION_DEADLINE_MINUTES=
# expo | fake. Default: expo in production, fake (log only) elsewhere
PUSH_PROVIDER=
# Only if "enhanced push security" is enabled in the Expo project (expo.dev > project > credentials)
EXPO_ACCESS_TOKEN=

# ---- Public routes and proxy
# true behind Caddy/another reverse proxy, so per-IP limits see the client IP (X-Forwarded-For)
TRUST_PROXY=false
# Requests per IP per 10 minutes: site contact form (POST /leads) and each /auth/otp/* route (request, verify)
RATE_LIMIT_LEADS_MAX=5
RATE_LIMIT_OTP_MAX=30
# Reminder lead time and waitlist offer validity are per professional (PATCH /me, PATCH /waitlist/rule)
