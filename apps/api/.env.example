# apps/api — copy to apps/api/.env for local development. Never commit .env.

# development | test | production
NODE_ENV=development
# HTTP server
HOST=0.0.0.0
PORT=3333
# fatal | error | warn | info | debug | trace (no message content or phones at info)
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (web site/panel, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Postgres from infra/docker-compose.yml (host port 5440)
DATABASE_URL=postgres://boramarca:boramarca@localhost:5440/boramarca
# Separate database for integration tests (created by infra/postgres/init.sql)
DATABASE_URL_TEST=postgres://boramarca:boramarca@localhost:5440/boramarca_test
# Redis from infra/docker-compose.yml (host port 6390). db 0 = app/BullMQ, db 1 = tests; Evolution uses db 6
REDIS_URL=redis://localhost:6390/0
REDIS_URL_TEST=redis://localhost:6390/1

# JWT secrets (at least 32 chars; generate with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))")
# In production the API refuses to start with a `change-me` value or with both secrets equal.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Token lifetimes. The refresh token rotates: each one works once (POST /auth/refresh), and
# POST /auth/logout ends the session.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Evolution API (infra/docker-compose.yml, host port 8085). Must match AUTHENTICATION_API_KEY in infra/.env
EVOLUTION_BASE_URL=http://localhost:8085
EVOLUTION_API_KEY=change-me-evolution-key
# Secret Evolution sends back on webhooks (header x-boramarca-webhook-secret). Production: 16+ chars,
# no `change-me`.
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret
# Public URL Evolution uses to reach this API (from inside Docker: host.docker.internal)
PUBLIC_API_URL=http://host.docker.internal:3333

# Store review demo account (plan section 9). Leave empty to disable. Works in production too:
# REVIEW_PHONE must be a number that belongs to no real professional (the fixed code opens it; a
# real account with that number is refused). Sample data and simulated WhatsApp, recreated on login.
REVIEW_PHONE=
REVIEW_OTP=

# Firebase Authentication by phone as the SMS provider of the login code (project id, not a secret;
# docs/PENDENCIAS-HUMANAS.md, item 3). Set: POST /auth/otp/request answers provider "firebase" (the
# app and the site send the SMS through Firebase) and POST /auth/firebase checks the ID token.
# Empty: POST /auth/firebase answers 503 and codes go by the API (log in development). The review
# account (REVIEW_PHONE) always uses its fixed code.
FIREBASE_PROJECT_ID=

# ---- Send guard (plan section 7; read by packages/whatsapp). Optional: empty = SEND_GUARD_DEFAULTS.
# Messages per instance per minute / per day
WA_GUARD_PER_MINUTE=
WA_GUARD_PER_DAY=
# "digitando..." before each message, in seconds
WA_GUARD_TYPING_MIN_SECONDS=
WA_GUARD_TYPING_MAX_SECONDS=
# Characters per message and max messages per text (longer texts are blocked)
WA_GUARD_MAX_CHARS=
WA_GUARD_MAX_PARTS=
# Queued messages older than this are dropped (e.g. after the session came back)
WA_GUARD_DROP_QUEUED_AFTER_MINUTES=

# ---- AI (read by packages/ia; see packages/ia/.env.example and README for providers).
# Without LLM_PRIMARY_*: outside production a simulated AI turns every message into a Decision;
# in production the AI is off and messages only reach the app.
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-flash
# Fallback used when the primary fails or times out (Qwen, Model Studio Singapore)
LLM_FALLBACK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen3.8-flash
# Per-attempt timeout in ms (default 15000)
LLM_TIMEOUT_MS=15000
# Audio transcription (OpenAI-compatible /audio/transcriptions, e.g. Groq Whisper).
# Without a key: fake transcription outside production; in production audios only reach the app.
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LANGUAGE=pt

# ---- Decisions and push notifications
# Minutes before the neutral "Já te confirmo!" goes to the client (default 10)
DECISION_DEADLINE_MINUTES=
# expo | fake. Default: expo in production, fake (log only) elsewhere
PUSH_PROVIDER=
# Only if "enhanced push security" is enabled in the Expo project (expo.dev > project > credentials)
EXPO_ACCESS_TOKEN=

# ---- Public routes and proxy
# true behind Caddy/another reverse proxy, so per-IP limits see the client IP (X-Forwarded-For)
TRUST_PROXY=false
# Requests per IP per 10 minutes: site contact form (POST /leads) and each /auth/otp/* route (request, verify)
RATE_LIMIT_LEADS_MAX=5
RATE_LIMIT_OTP_MAX=30
# Reminder lead time and waitlist offer validity are per professional (PATCH /me, PATCH /waitlist/rule)

# ---- Alexa (plan section 14; same names as packages/alexa/.env.example, steps in docs/PENDENCIAS-HUMANAS.md, item 16).
# Without the three below, POST /v1/alexa/skill and the account linking routes answer 503.
# Skill id from the Alexa developer console (amzn1.ask.skill....). Requests for any other skill are rejected.
ALEXA_SKILL_ID=
# Account linking (Build > Account Linking in the console). Same values in both places.
# Client ID: any stable string, e.g. "alexa-skill".
ALEXA_OAUTH_CLIENT_ID=
# Client secret: long random string (openssl rand -hex 32), at least 16 characters.
ALEXA_OAUTH_CLIENT_SECRET=
# Voice Monkey v3 API token (voicemonkey.io > Dashboard > API). Each professional normally saves
# their own token in PATCH /v1/alexa/settings; this one is only the fallback for those who did not.
# Empty = no fallback. v2 tokens do not work.
VOICE_MONKEY_TOKEN=
# Encrypts secrets saved per professional (Voice Monkey token), AES-256-GCM. 32 bytes in base64:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Never change it once tokens are saved (they become unreadable). Empty: saving a token answers 503.
DATA_ENCRYPTION_KEY=

# ---- Transactional e-mail (Velomail; docs/OPERACAO.md, "E-mail transacional").
# Send-only key of the boramarca.com.br domain. Empty: no mail leaves the API, it is only logged
# (body included outside production, so the confirmation link shows up in the dev log).
VELOMAIL_API_KEY=
VELOMAIL_API_URL=https://www.velomail.com.br/api/emails/send
MAIL_FROM=Bora Marca <nao-responda@boramarca.com.br>
MAIL_REPLY_TO=contato@boramarca.com.br
# Team inbox that gets a notice for each site lead/contact message. Empty: no notice.
MAIL_OPS_TO=
# Public addresses used inside e-mails: logo and confirmation result page (site), confirmation
# link (API). Local: PUBLIC_API_BASE_URL=http://localhost:3333 and PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=https://boramarca.com.br
PUBLIC_API_BASE_URL=https://api.boramarca.com.br

# ---- Subscription billing (Asaas; docs/COBRANCA.md). Empty key: billing is off (subscribe/change/
# cancel answer 503 BILLING_DISABLED) and everything else works. The key starts with "$aact_": in an
# .env read by Docker Compose write it between SINGLE quotes ('$aact_prod_...').
ASAAS_API_KEY=
# Production: https://api.asaas.com/v3 (default). Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
# Token registered on the Asaas webhook (https://api.boramarca.com.br/v1/webhooks/asaas), 32-255
# characters: openssl rand -hex 32. Empty: the webhook answers 401.
ASAAS_WEBHOOK_TOKEN=
# Days an overdue charge is tolerated before the AI and the automatic reminders pause.
BILLING_GRACE_DAYS=7
