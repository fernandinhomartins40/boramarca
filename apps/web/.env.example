# apps/web — copy to apps/web/.env.local. NEXT_PUBLIC_* values are embedded at build time.

# Public API base URL (apps/api), without /v1. The contact form (POST /leads) and the account
# deletion page (OTP + DELETE /me) call it from the browser, so the API's CORS_ORIGINS must
# include this site's origin. Local: port 3333
NEXT_PUBLIC_API_URL=http://localhost:3333
# Canonical site URL used in metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://boramarca.com.br
# Support / privacy (DPO) e-mail shown on /contato, /privacidade, /termos and /excluir-conta
NEXT_PUBLIC_SUPPORT_EMAIL=contato@boramarca.com.br
# Store links: when set, the landing shows the store buttons
NEXT_PUBLIC_PLAY_URL=
NEXT_PUBLIC_APPSTORE_URL=
# Firebase Authentication by phone (project rapidinho-entrega, shared by the owner's own products, web app; public values, not secrets).
# Used only when the API answers provider "firebase" (FIREBASE_PROJECT_ID set on the API): the
# panel login and /excluir-conta then send the SMS through Firebase. Empty = codes by the API only.
# infra/docker/web.Dockerfile already has the production values as defaults.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
